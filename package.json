{
  "name": "github-review-order",
  "version": "1.0.0",
  "description": "A browser extension that lets you propose a order in which to review files inside of a github pull request, together with a navigation utility that follows that order",
  "homepage": "https://github.com/RunOrVeith/github-review-order#readme",
  "bugs": {
    "url": "https://github.com/RunOrVeith/github-review-order/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/RunOrVeith/github-review-order.git"
  },
  "license": "MIT",
  "author": "Veith Röthlingshöfer",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "postinstall": "wxt prepare",
    "compile": "svelte-check --tsgo --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "wxt build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@wxt-dev/module-svelte": "^2.0.5",
    "jsdom": "^29.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.4"
  }
}
